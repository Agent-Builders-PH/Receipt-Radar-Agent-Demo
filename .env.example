# Copy this file to .env and fill in your own values.
# .env is in .gitignore, so it never gets committed.

# 1. Claude Console -> API keys  (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 2. OCR mode. Leave it on cached: the sample receipts already have their Lumen OCR saved.
#    live = call Lumen OCR for real: about 8 credits a photo; needs the two Lumen keys below.
#    Use it for your own receipts (my-receipts/).
OCR_MODE=cached

# 3. Lumen OCR sandbox key and secret: the host gives you these (live mode only)
LUMEN_OCR_BASE_URL=https://api.staging.nonlive.lumen.bayanichain.tech/ocr
LUMEN_API_KEY=
LUMEN_API_SECRET=

# Optional: another Claude model
# RADAR_MODEL=claude-sonnet-5-5
